<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/spacing_20">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/dialog_add_assignment_title"
        android:textColor="@color/ink_primary"
        android:textSize="@dimen/text_title"
        android:textStyle="bold" />

    <!-- Assignment Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_16"
        android:text="@string/label_assignment_title"
        android:textColor="@color/text_secondary_slate"
        android:textSize="@dimen/text_caption"
        android:labelFor="@id/et_dialog_assignment_title" />

    <EditText
        android:id="@+id/et_dialog_assignment_title"
        android:layout_width="match_parent"
        android:layout_height="@dimen/min_touch_target"
        android:layout_marginTop="@dimen/spacing_4"
        android:background="@drawable/bg_input_field"
        android:importantForAutofill="no"
        android:inputType="textCapSentences"
        android:paddingHorizontal="@dimen/spacing_12"
        android:textColor="@color/ink_primary"
        android:textSize="@dimen/text_body" />

    <!-- Subject Selection -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_12"
        android:text="@string/label_subject"
        android:textColor="@color/text_secondary_slate"
        android:textSize="@dimen/text_caption" />

    <Spinner
        android:id="@+id/spinner_dialog_assignment_subject"
        android:layout_width="match_parent"
        android:layout_height="@dimen/min_touch_target"
        android:layout_marginTop="@dimen/spacing_4"
        android:background="@drawable/bg_input_field"
        android:paddingHorizontal="@dimen/spacing_8" />

    <TextView
        android:id="@+id/tv_dialog_subjects_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_4"
        android:text="@string/assignment_subjects_empty"
        android:textColor="@color/text_secondary_slate"
        android:textSize="@dimen/text_caption"
        android:visibility="gone" />

    <!-- Priority Selection Radio Buttons -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_12"
        android:text="Priority"
        android:textColor="@color/text_secondary_slate"
        android:textSize="@dimen/text_caption" />

    <RadioGroup
        android:id="@+id/rg_assignment_priority"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_4"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/rb_priority_low"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Low"
            android:textColor="@color/accent_moss" />

        <RadioButton
            android:id="@+id/rb_priority_medium"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:checked="true"
            android:text="Medium"
            android:textColor="@color/ink_primary" />

        <RadioButton
            android:id="@+id/rb_priority_high"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="High"
            android:textColor="@color/accent_persimmon" />
    </RadioGroup>

    <!-- Due Date Selection -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_12"
        android:text="@string/label_due_date"
        android:textColor="@color/text_secondary_slate"
        android:textSize="@dimen/text_caption" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_dialog_due_date_picker"
        style="@style/Widget.CampusMate.Button.Outlined"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_4"
        android:gravity="start|center_vertical"
        android:text="@string/btn_select_due_date" />

    <!-- Completed Checkbox -->
    <CheckBox
        android:id="@+id/cb_dialog_completed"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/min_touch_target"
        android:layout_marginTop="@dimen/spacing_8"
        android:buttonTint="@color/accent_moss"
        android:text="@string/label_completed"
        android:textColor="@color/ink_primary"
        android:textSize="@dimen/text_body" />

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_16"
        android:gravity="end"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_dialog_cancel"
            style="@style/Widget.CampusMate.Button.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/spacing_8"
            android:text="@string/action_cancel" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_dialog_save_assignment"
            style="@style/Widget.CampusMate.Button.Primary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/btn_save_assignment" />
    </LinearLayout>

</LinearLayout>