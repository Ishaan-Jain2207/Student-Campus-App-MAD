<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/spacing_20">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Add Campus Resource"
        android:textColor="@color/ink_primary"
        android:textSize="@dimen/text_title"
        android:textStyle="bold" />

    <!-- Subject Category Spinner -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_16"
        android:text="Select Subject / Category"
        android:textColor="@color/text_secondary_slate"
        android:textSize="@dimen/text_caption" />

    <Spinner
        android:id="@+id/spinner_dialog_resource_subject"
        android:layout_width="match_parent"
        android:layout_height="@dimen/min_touch_target"
        android:layout_marginTop="@dimen/spacing_4"
        android:background="@drawable/bg_input_field"
        android:paddingHorizontal="@dimen/spacing_8" />

    <!-- Choose File Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_dialog_choose_file"
        style="@style/Widget.CampusMate.Button.Outlined"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_12"
        android:text="Choose Document / File"
        app:icon="@drawable/ic_resources"
        app:iconTint="@color/accent_moss" />

    <TextView
        android:id="@+id/tv_dialog_selected_file"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_4"
        android:text="No file selected"
        android:textColor="@color/text_secondary_slate"
        android:textSize="@dimen/text_caption" />

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_20"
        android:gravity="end"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_dialog_cancel"
            style="@style/Widget.CampusMate.Button.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/spacing_8"
            android:text="@string/action_cancel" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_dialog_save_resource"
            style="@style/Widget.CampusMate.Button.Primary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add Resource" />
    </LinearLayout>

</LinearLayout>