<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/spacing_16">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/heading_resources_list"
        android:textColor="@color/ink_primary"
        android:textSize="@dimen/text_title"
        android:textStyle="bold" />

    <!-- Subject Category Filter Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_12"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Spinner
            android:id="@+id/spinner_resource_subject_filter"
            android:layout_width="0dp"
            android:layout_height="@dimen/min_touch_target"
            android:layout_weight="1"
            android:background="@drawable/bg_input_field"
            android:paddingHorizontal="@dimen/spacing_8" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_add_resource"
        style="@style/Widget.CampusMate.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_8"
        android:text="@string/resource_add_button"
        app:icon="@drawable/ic_add"
        app:iconTint="@color/surface_warm_white" />

    <TextView
        android:id="@+id/tv_resources_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_12"
        android:background="@drawable/bg_card_surface"
        android:padding="@dimen/spacing_16"
        android:text="@string/resources_empty"
        android:textColor="@color/text_secondary_slate"
        android:textSize="@dimen/text_body"
        android:visibility="gone" />

    <!-- Resources List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_resources"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/spacing_12"
        android:layout_weight="1" />

</LinearLayout>