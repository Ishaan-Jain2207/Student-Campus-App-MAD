<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_16">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/heading_profile_details"
            android:textColor="@color/ink_primary"
            android:textSize="@dimen/text_title"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_profile_unavailable"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_8"
            android:background="@drawable/bg_banner_notice"
            android:padding="@dimen/spacing_12"
            android:text="@string/profile_not_synced"
            android:textColor="@color/text_secondary_slate"
            android:textSize="@dimen/text_body"
            android:visibility="gone" />

        <!-- Profile Header Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_12"
            android:background="@drawable/bg_card_surface"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/spacing_24">

            <ImageView
                android:id="@+id/img_profile_avatar"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:contentDescription="@string/title_profile"
                android:src="@drawable/ic_avatar" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_choose_profile_photo"
                style="@style/Widget.CampusMate.Button.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_4"
                android:text="@string/profile_choose_photo"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_profile_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_12"
                android:textColor="@color/ink_primary"
                android:textSize="@dimen/text_title"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_profile_dept_year"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_4"
                android:textColor="@color/text_secondary_slate"
                android:textSize="@dimen/text_body" />
        </LinearLayout>

        <!-- Profile Identity Fields Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_16"
            android:background="@drawable/bg_card_surface"
            android:orientation="vertical"
            android:padding="@dimen/spacing_16">

            <!-- Full Name -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:labelFor="@id/et_profile_name"
                android:text="@string/label_student_name"
                android:textColor="@color/text_secondary_slate"
                android:textSize="@dimen/text_caption" />

            <EditText
                android:id="@+id/et_profile_name"
                android:layout_width="match_parent"
                android:layout_height="@dimen/min_touch_target"
                android:layout_marginTop="@dimen/spacing_4"
                android:background="@drawable/bg_input_field"
                android:autofillHints="personName"
                android:enabled="false"
                android:inputType="textPersonName"
                android:paddingHorizontal="@dimen/spacing_12"
                android:textColor="@color/ink_primary"
                android:textSize="@dimen/text_body" />

            <!-- SAP ID -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_12"
                android:labelFor="@id/et_profile_sap_id"
                android:text="@string/label_roll_number"
                android:textColor="@color/text_secondary_slate"
                android:textSize="@dimen/text_caption" />

            <EditText
                android:id="@+id/et_profile_sap_id"
                android:layout_width="match_parent"
                android:layout_height="@dimen/min_touch_target"
                android:layout_marginTop="@dimen/spacing_4"
                android:background="@drawable/bg_input_field"
                android:autofillHints="username"
                android:enabled="false"
                android:inputType="number"
                android:paddingHorizontal="@dimen/spacing_12"
                android:textColor="@color/ink_primary"
                android:textSize="@dimen/text_body" />

            <!-- Email -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_12"
                android:labelFor="@id/et_profile_email"
                android:text="@string/hint_email"
                android:textColor="@color/text_secondary_slate"
                android:textSize="@dimen/text_caption" />

            <EditText
                android:id="@+id/et_profile_email"
                android:layout_width="match_parent"
                android:layout_height="@dimen/min_touch_target"
                android:layout_marginTop="@dimen/spacing_4"
                android:background="@drawable/bg_input_field"
                android:autofillHints="emailAddress"
                android:enabled="false"
                android:inputType="textEmailAddress"
                android:paddingHorizontal="@dimen/spacing_12"
                android:textColor="@color/ink_primary"
                android:textSize="@dimen/text_body" />

            <!-- Department -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_12"
                android:labelFor="@id/et_profile_department"
                android:text="@string/label_department"
                android:textColor="@color/text_secondary_slate"
                android:textSize="@dimen/text_caption" />

            <EditText
                android:id="@+id/et_profile_department"
                android:layout_width="match_parent"
                android:layout_height="@dimen/min_touch_target"
                android:layout_marginTop="@dimen/spacing_4"
                android:background="@drawable/bg_input_field"
                android:importantForAutofill="no"
                android:enabled="false"
                android:inputType="text"
                android:paddingHorizontal="@dimen/spacing_12"
                android:textColor="@color/ink_primary"
                android:textSize="@dimen/text_body" />

            <!-- Year -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_12"
                android:labelFor="@id/et_profile_year"
                android:text="@string/label_semester"
                android:textColor="@color/text_secondary_slate"
                android:textSize="@dimen/text_caption" />

            <EditText
                android:id="@+id/et_profile_year"
                android:layout_width="match_parent"
                android:layout_height="@dimen/min_touch_target"
                android:layout_marginTop="@dimen/spacing_4"
                android:background="@drawable/bg_input_field"
                android:importantForAutofill="no"
                android:enabled="false"
                android:inputType="text"
                android:paddingHorizontal="@dimen/spacing_12"
                android:textColor="@color/ink_primary"
                android:textSize="@dimen/text_body" />

            <!-- Action Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_edit_profile"
                style="@style/Widget.CampusMate.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_20"
                android:text="@string/btn_edit_profile" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
