<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/spacing_16">

    <!-- Keep the main action on its own row so it does not squeeze the heading. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/heading_assignments_list"
            android:textColor="@color/ink_primary"
            android:textSize="@dimen/text_title"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinner_assignment_periods"
            android:layout_width="match_parent"
            android:layout_height="@dimen/min_touch_target"
            android:layout_marginTop="@dimen/spacing_8"
            android:background="@drawable/bg_input_field"
            android:paddingHorizontal="@dimen/spacing_8" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_add_assignment_dialog"
            style="@style/Widget.CampusMate.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_8"
            android:text="@string/btn_new_assignment" />
    </LinearLayout>

    <!-- Empty State Message -->
    <TextView
        android:id="@+id/tv_assignments_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_16"
        android:background="@drawable/bg_card_surface"
        android:padding="@dimen/spacing_16"
        android:text="@string/empty_assignments_msg"
        android:textColor="@color/text_secondary_slate"
        android:textSize="@dimen/text_body"
        android:visibility="gone" />

    <!-- Assignments List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_assignments"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/spacing_12"
        android:layout_weight="1" />

</LinearLayout>
