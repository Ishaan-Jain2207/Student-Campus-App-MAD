<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_20">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/event_dialog_title"
            android:textColor="@color/ink_primary"
            android:textSize="@dimen/text_title"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/et_event_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_12"
            android:hint="@string/event_name_hint"
            android:importantForAutofill="no"
            android:inputType="textCapSentences"
            android:minHeight="@dimen/min_touch_target" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_event_date"
            style="@style/Widget.CampusMate.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_8"
            android:text="@string/event_choose_date" />

        <EditText
            android:id="@+id/et_event_venue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_8"
            android:hint="@string/event_venue_hint"
            android:importantForAutofill="no"
            android:inputType="textCapSentences"
            android:minHeight="@dimen/min_touch_target" />

        <EditText
            android:id="@+id/et_event_details"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_8"
            android:gravity="top"
            android:hint="@string/event_details_hint"
            android:importantForAutofill="no"
            android:inputType="textCapSentences|textMultiLine"
            android:minHeight="88dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_event_image"
            style="@style/Widget.CampusMate.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_8"
            android:text="@string/event_choose_image" />

        <ImageView
            android:id="@+id/img_event_preview"
            android:layout_width="match_parent"
            android:layout_height="136dp"
            android:layout_marginTop="@dimen/spacing_8"
            android:contentDescription="@string/event_image_description"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_12"
            android:gravity="end"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_event_cancel"
                style="@style/Widget.CampusMate.Button.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/action_cancel" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_event_save"
                style="@style/Widget.CampusMate.Button.Primary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_8"
                android:text="@string/event_save" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
