<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="@dimen/spacing_24">

        <ImageView
            android:id="@+id/img_register_logo"
            android:layout_width="@dimen/logo_size_medium"
            android:layout_height="@dimen/logo_size_medium"
            android:layout_marginTop="@dimen/spacing_16"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_logo" />

        <TextView
            android:id="@+id/tv_register_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_12"
            android:text="@string/register_title"
            android:textColor="@color/ink_primary"
            android:textSize="@dimen/text_display"
            android:textStyle="bold" />

        <!-- Full Name -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_register_name"
            style="@style/Widget.CampusMate.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_20"
            android:hint="@string/hint_full_name">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_register_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPersonName"
                android:maxLines="1"
                android:textColor="@color/ink_primary"
                android:textSize="@dimen/text_body" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- SAP ID -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_register_sap_id"
            style="@style/Widget.CampusMate.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_12"
            android:hint="@string/hint_sap_id_num">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_register_sap_id"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:maxLines="1"
                android:textColor="@color/ink_primary"
                android:textSize="@dimen/text_body" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Institutional Email -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_register_email"
            style="@style/Widget.CampusMate.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_12"
            android:hint="@string/hint_email">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_register_email"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textEmailAddress"
                android:maxLines="1"
                android:textColor="@color/ink_primary"
                android:textSize="@dimen/text_body" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Department Spinner -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_12"
            android:text="@string/registration_department_label"
            android:textColor="@color/text_secondary_slate"
            android:textSize="@dimen/text_caption" />

        <Spinner
            android:id="@+id/spinner_register_dept"
            android:layout_width="match_parent"
            android:layout_height="@dimen/min_touch_target"
            android:layout_marginTop="@dimen/spacing_4"
            android:background="@drawable/bg_input_field"
            android:entries="@array/departments_array"
            android:paddingHorizontal="@dimen/spacing_8" />

        <!-- Academic Year Spinner -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_12"
            android:text="@string/registration_year_label"
            android:textColor="@color/text_secondary_slate"
            android:textSize="@dimen/text_caption" />

        <Spinner
            android:id="@+id/spinner_register_year"
            android:layout_width="match_parent"
            android:layout_height="@dimen/min_touch_target"
            android:layout_marginTop="@dimen/spacing_4"
            android:background="@drawable/bg_input_field"
            android:entries="@array/years_array"
            android:paddingHorizontal="@dimen/spacing_8" />

        <!-- Password -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_register_password"
            style="@style/Widget.CampusMate.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_12"
            android:hint="@string/hint_password"
            app:passwordToggleEnabled="true"
            app:passwordToggleTint="@color/text_secondary_slate">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_register_password"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPassword"
                android:maxLines="1"
                android:textColor="@color/ink_primary"
                android:textSize="@dimen/text_body" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Confirm Password -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_register_confirm_password"
            style="@style/Widget.CampusMate.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_12"
            android:hint="@string/hint_confirm_password"
            app:passwordToggleEnabled="true"
            app:passwordToggleTint="@color/text_secondary_slate">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_register_confirm_password"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPassword"
                android:maxLines="1"
                android:textColor="@color/ink_primary"
                android:textSize="@dimen/text_body" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Register Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_register"
            style="@style/Widget.CampusMate.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_20"
            android:text="@string/button_register" />

        <!-- Link to Sign In -->
        <TextView
            android:id="@+id/tv_link_sign_in"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/min_touch_target"
            android:layout_marginTop="@dimen/spacing_12"
            android:gravity="center"
            android:text="@string/link_sign_in"
            android:textColor="@color/accent_moss"
            android:textSize="@dimen/text_body"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>
